diff --git a/tests/test_auth_forms.c b/tests/test_auth_forms.c
index 9685a31..e808e91 100644
--- a/tests/test_auth_forms.c
+++ b/tests/test_auth_forms.c
@@ -87,12 +87,69 @@ static void check_page(int register_page) {
     free(s.output);
 }
 
+/* A single style constructor can target different HTML tags. */
+static void check_red_black_border_css(void) {
+    dummy_handler s = {0};
+    web_node* button = NEW_WN(WNA_HTML(button), STRRS_REFSTC("Save"),
+        STRRS_REFSTC("type=\"button\""),
+        WNA_SUBNODES(DOM_red_black_border_css()));
+    web_node* link = NEW_WN(WNA_HTML(a), STRRS_REFSTC("Home"),
+        STRRS_REFSTC("href=\"/index\""),
+        WNA_SUBNODES(DOM_red_black_border_css()));
+    web_node* form = DOM_login_form();
+    assert(wn_attach(form, DOM_red_black_border_css_custom(3, 12, 6)) == OK);
+    web_node* register_form = DOM_red_black_border_on(DOM_register_form());
+    assert(register_form != NULL);
+    web_node* box = DOM_red_black_border_box(NEW_WN(WNA_HTML(plain), STRRS_REFSTC("Wrapped")));
+    web_node* tree = NEW_WN(WNA_HTML(div), STRRS_STATIC(REG_HTML_GLOB),
+        WNA_SUBNODES(button, link, form, box, register_form));
+    web_node* root = wn_wrap_html_root(tree);
+
+    assert(wn_deliver(&s, root) == OK);
+    assert(s.output);
+    assert(strstr(s.output, "background-color: red; border: 2px solid black; "
+                            "padding: 8px; border-radius: 4px; box-sizing: border-box;") != NULL);
+    assert(strstr(s.output, "background-color: red; border: 3px solid black; "
+                            "padding: 12px; border-radius: 6px; box-sizing: border-box;") != NULL);
+    /* The styled elements themselves have IDs; no additional wrapper is
+       introduced for the button, link, or form. */
+    assert(strstr(s.output, "<button id=\"wn") != NULL);
+    assert(strstr(s.output, "<a id=\"wn") != NULL);
+    assert(strstr(s.output, "<form id=\"wn") != NULL);
+    assert(strstr(s.output, "Wrapped</div>") != NULL);
+    assert(strstr(s.output, "<div id=\"wn") != NULL);
+    /* Attaching a CSS node must not reverse a form's existing fields. */
+    const char* form_start = strstr(s.output, "<form id=\"wn");
+    assert(form_start);
+    const char* username = strstr(form_start, "for=\"login-username\"");
+    const char* password = strstr(form_start, "for=\"login-password\"");
+    const char* button_start = strstr(form_start, "<button type=\"submit\">Login</button>");
+    assert(username && password && button_start);
+    assert(username < password && password < button_start);
+    /* Verify each CSS rule actually targets its element, rather than only
+       appearing somewhere in the stylesheet. */
+    const char* tags[] = {"<button id=\"wn", "<a id=\"wn", "<form id=\"wn"};
+    for (size_t i = 0; i < sizeof(tags) / sizeof(tags[0]); i++) {
+        const char* element = strstr(s.output, tags[i]);
+        assert(element);
+        unsigned id = 0;
+        assert(sscanf(element + strlen(tags[i]), "%u", &id) == 1);
+        char selector[64];
+        snprintf(selector, sizeof(selector), "#wn%u  {background-color: red;", id);
+        assert(strstr(s.output, selector) != NULL);
+    }
+
+    delete_web_node(root);
+    free(s.output);
+}
